# NOC Pre-Triage Agent — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#
# The application loads these at startup via python-dotenv or your shell.

# ── Ollama LLM Settings ───────────────────────────────────────────────────────
# Local Ollama server URL (default: localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for triage note generation
# Supported: llama3.1, mistral, qwen2.5 (must be pulled in Ollama first)
# Pull command: ollama pull llama3.1
OLLAMA_MODEL=llama3.1

# ── RAG / Chroma Settings ─────────────────────────────────────────────────────
# Directory where Chroma persists its vector database
CHROMA_PERSIST_DIR=chroma_db/

# Sentence-transformers embedding model (downloads automatically on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Paths ─────────────────────────────────────────────────────────────────────
RUNBOOKS_DIR=runbooks/
OUTPUTS_DIR=outputs/
AUDIT_LOG_PATH=logs/audit.jsonl

# ── HashiCorp Vault (Phase 2 — live device mode) ──────────────────────────────
# Leave blank for MVP mock mode. These are used only when --mock is NOT set.
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
# VAULT_MOUNT_PATH=secret
# VAULT_SECRET_PATH=noc/cisco_readonly

# ── Cisco Service Account (MVP — .env only, Phase 2 moves to Vault) ───────────
# Used only in live (non-mock) mode via the command broker.
# The broker reads these at runtime — they are NEVER passed to the LLM or logs.
# CISCO_USERNAME=noc_readonly
# CISCO_PASSWORD=
# CISCO_ENABLE_SECRET=

# ── Safety Settings ───────────────────────────────────────────────────────────
# Override max commands per ticket (default from allowed_commands.yaml)
# MAX_COMMANDS_PER_TICKET=15

# ── Logging ───────────────────────────────────────────────────────────────────
# Set to DEBUG for verbose output during development
LOG_LEVEL=INFO
